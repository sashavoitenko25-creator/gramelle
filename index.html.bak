<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
  <title>Gramelle — PvP Roulette</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            dark: '#0a0a0f',
            card: '#16161f',
          }
        }
      }
    }
  </script>
  <style>
    * { box-sizing: border-box; }
    body {
      background: #0a0a0f;
      color: white;
      font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
      overflow-x: hidden;
      margin: 0;
      min-height: 100dvh;
    }
    .starfield {
      background-image: 
        radial-gradient(1px 1px at 20px 30px, #fff 1px, transparent 0),
        radial-gradient(1px 1px at 40px 70px, #fff 1px, transparent 0),
        radial-gradient(1px 1px at 50px 160px, #fff 1px, transparent 0),
        radial-gradient(1px 1px at 90px 40px, #fff 1px, transparent 0),
        radial-gradient(1px 1px at 130px 80px, #fff 1px, transparent 0),
        radial-gradient(1.5px 1.5px at 160px 120px, #fff 1px, transparent 0),
        radial-gradient(1px 1px at 200px 50px, #fff 1px, transparent 0),
        radial-gradient(1px 1px at 250px 180px, #fff 1px, transparent 0),
        radial-gradient(1px 1px at 300px 90px, #fff 1px, transparent 0),
        radial-gradient(1.5px 1.5px at 350px 140px, #fff 1px, transparent 0);
      background-size: 400px 200px;
      background-repeat: repeat;
    }
    .wheel-container { position: relative; width: 240px; height: 240px; }
    .wheel {
      width: 100%; height: 100%; border-radius: 50%;
      transition: transform 4.2s cubic-bezier(0.12, 0.8, 0.2, 1);
      box-shadow: 0 0 40px rgba(147, 51, 234, 0.35), 0 0 80px rgba(147, 51, 234, 0.15);
    }
    .wheel.empty {
      background: linear-gradient(145deg, #2a2a35, #1a1a24) !important;
      box-shadow: 0 0 30px rgba(100, 100, 120, 0.2);
    }
    .wheel-pointer {
      position: absolute; top: -8px; left: 50%; transform: translateX(-50%);
      z-index: 20; font-size: 22px; filter: drop-shadow(0 2px 4px rgba(0,0,0,0.5)); color: #fff;
    }
    .wheel-center {
      position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%);
      width: 78px; height: 78px; border-radius: 50%; background: #0a0a0f;
      border: 2px solid rgba(255,255,255,0.08); display: flex; flex-direction: column;
      align-items: center; justify-content: center; z-index: 10;
      box-shadow: inset 0 0 20px rgba(0,0,0,0.5);
    }
    .modal-backdrop { background: rgba(0,0,0,0.7); backdrop-filter: blur(6px); }
    .slide-up { animation: slideUp 0.3s ease-out; }
    @keyframes slideUp {
      from { transform: translateY(40px); opacity: 0; }
      to { transform: translateY(0); opacity: 1; }
    }
    .fade-in { animation: fadeIn 0.25s ease-out; }
    @keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
    .pulse-dot { animation: pulse 1.5s infinite; }
    @keyframes pulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.4; } }
    .safe-bottom { padding-bottom: max(12px, env(safe-area-inset-bottom)); }
    input[type=number]::-webkit-inner-spin-button,
    input[type=number]::-webkit-outer-spin-button { -webkit-appearance: none; margin: 0; }
    .filter-btn.active { background: #2a2a3a; color: white; }
  </style>
</head>
<body class="starfield min-h-screen flex flex-col text-white">

  <!-- PVP SCREEN -->
  <div id="screen-pvp" class="flex flex-col min-h-screen pb-20">
    <div class="flex items-center justify-between px-4 pt-3 pb-2">
      <div class="flex items-center gap-1.5 text-xs text-emerald-400">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 pulse-dot"></span>
        <span id="online-count">72 online</span>
      </div>
      <div class="flex gap-2">
        <button onclick="showScreen('history')" class="w-8 h-8 rounded-full bg-white/5 flex items-center justify-center text-white/60 hover:bg-white/10 transition text-sm" title="History">⏱</button>
        <button class="w-8 h-8 rounded-full bg-white/5 flex items-center justify-center text-white/60 text-sm">✕</button>
      </div>
    </div>

    <div class="mx-4 mb-4 flex items-center justify-center">
      <div class="px-5 py-2 rounded-full bg-card border border-white/10">
        <span class="text-sm font-semibold tracking-wide">TOTAL <span id="total-bank" class="text-cyan-300">0 GRAM</span></span>
      </div>
    </div>

    <div class="relative flex justify-center mb-5">
      <div class="wheel-container">
        <div class="wheel-pointer">▼</div>
        <div id="wheel" class="wheel empty"></div>
        <div class="wheel-center">
          <div id="wheel-avatar" class="w-7 h-7 rounded-full bg-gradient-to-br from-gray-500 to-gray-700 mb-1 flex items-center justify-center text-xs">👤</div>
          <span id="wheel-status" class="text-[11px] text-white/60 font-medium">Waiting</span>
        </div>
      </div>
    </div>

    <div class="mx-4 mb-3 flex items-center justify-between">
      <div class="flex items-center gap-1.5 bg-card rounded-full px-2 py-1 border border-white/5">
        <button class="w-7 h-7 rounded-full bg-white/10 flex items-center justify-center text-xs">💎</button>
      </div>
      <div class="flex items-center gap-1.5 bg-card rounded-full px-3 py-1.5 border border-white/5">
        <span class="text-cyan-300 text-sm">💎</span>
        <span id="user-balance" class="text-sm font-medium">25.00</span>
        <button onclick="openDeposit()" class="w-5 h-5 rounded-full bg-white/10 flex items-center justify-center text-xs ml-1">+</button>
      </div>
    </div>

    <div class="mx-4 mb-5 flex gap-3">
      <button onclick="openAddBet()" class="flex-1 h-12 rounded-xl bg-gradient-to-r from-amber-500 to-yellow-400 text-black font-semibold text-sm shadow-lg shadow-amber-500/25 active:scale-[0.98] transition">+ Add to PvP</button>
      <button onclick="openAddBet()" class="flex-1 h-12 rounded-xl bg-gradient-to-r from-blue-600 to-cyan-500 text-white font-semibold text-sm shadow-lg shadow-blue-500/25 flex items-center justify-center gap-1.5 active:scale-[0.98] transition">
        <span>💎</span><span id="bet-btn-balance">25.00 Gram</span>
      </button>
    </div>

    <div class="mx-4 mb-2 flex items-center justify-between">
      <span class="text-sm text-white/70"><span id="player-count">0</span> Players</span>
      <span class="text-xs text-white/40">ROLL #<span id="roll-id">624900</span></span>
    </div>

    <div id="players-list" class="mx-4 flex-1 space-y-2 mb-4 min-h-[80px]"></div>

    <div class="text-center text-[10px] text-white/20 mb-2 px-4">
      Hash <span id="round-hash">a3f8c2...9e1b4d</span> 🔗
    </div>
  </div>

  <!-- HISTORY SCREEN -->
  <div id="screen-history" class="hidden flex-col min-h-screen pb-20">
    <div class="flex items-center justify-between px-4 pt-3 pb-3">
      <button onclick="showScreen('pvp')" class="w-8 h-8 rounded-full bg-white/5 flex items-center justify-center text-white/60">‹</button>
      <h1 class="text-lg font-semibold">PvP History</h1>
      <div class="w-8"></div>
    </div>

    <div class="mx-4 mb-3 flex gap-2 overflow-x-auto pb-1">
      <button onclick="setHistoryFilter('all')" data-filter="all" class="filter-btn active px-3 py-1.5 rounded-full bg-white/5 text-xs font-medium whitespace-nowrap">All</button>
      <button onclick="setHistoryFilter('lucky')" data-filter="lucky" class="filter-btn px-3 py-1.5 rounded-full bg-white/5 text-xs font-medium whitespace-nowrap text-white/50">🍀 Lucky</button>
      <button onclick="setHistoryFilter('top')" data-filter="top" class="filter-btn px-3 py-1.5 rounded-full bg-white/5 text-xs font-medium whitespace-nowrap text-white/50">💰 Top win</button>
    </div>

    <div class="mx-4 mb-4">
      <div class="relative">
        <span class="absolute left-3 top-1/2 -translate-y-1/2 text-white/30 text-sm">🔍</span>
        <input id="history-search" type="text" placeholder="Search by roll number"
          class="w-full bg-card border border-white/5 rounded-xl py-2.5 pl-9 pr-3 text-sm text-white placeholder-white/30 outline-none focus:border-white/20"
          oninput="renderHistory()" />
      </div>
    </div>

    <div id="history-list" class="mx-4 space-y-2.5 flex-1 overflow-y-auto pb-4"></div>
  </div>

  <!-- PROFILE SCREEN -->
  <div id="screen-profile" class="hidden flex-col min-h-screen pb-20">
    <div class="flex items-center justify-between px-4 pt-3 pb-2">
      <div class="flex items-center gap-1.5 text-xs text-emerald-400">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 pulse-dot"></span>
        <span id="online-count-2">72 online</span>
      </div>
      <div class="flex gap-2">
        <button class="w-8 h-8 rounded-full bg-white/5 flex items-center justify-center text-white/60 text-sm">⚙</button>
        <button class="w-8 h-8 rounded-full bg-white/5 flex items-center justify-center text-white/60 text-sm">✕</button>
      </div>
    </div>

    <div class="flex flex-col items-center pt-6 pb-6">
      <div class="w-20 h-20 rounded-full bg-gradient-to-br from-purple-500 to-cyan-500 p-0.5 mb-3">
        <div class="w-full h-full rounded-full bg-dark flex items-center justify-center text-3xl">👤</div>
      </div>
      <div class="text-lg font-semibold" id="profile-username">@You</div>
    </div>

    <div class="mx-4 mb-4 rounded-2xl bg-card border border-white/5 p-4">
      <div class="text-xs text-white/40 mb-1">Gramelle balance</div>
      <div class="flex items-center justify-between">
        <div class="flex items-center gap-2">
          <span class="text-cyan-300">💎</span>
          <span id="profile-balance" class="text-xl font-bold">25.00 GRAM</span>
        </div>
        <div class="flex gap-2">
          <button onclick="openDeposit()" class="px-4 py-1.5 rounded-lg bg-blue-500 text-sm font-medium hover:bg-blue-600 transition">Deposit</button>
        </div>
      </div>
    </div>

    <div class="mx-4 rounded-2xl bg-card border border-white/5 overflow-hidden">
      <button onclick="showScreen('referrals')" class="w-full flex items-center justify-between px-4 py-3.5 hover:bg-white/5 transition">
        <div class="flex items-center gap-3">
          <span class="text-lg">💎</span>
          <span class="text-sm">Referrals</span>
        </div>
        <span class="text-white/30">›</span>
      </button>
    </div>
  </div>

  <!-- REFERRALS SCREEN -->
  <div id="screen-referrals" class="hidden flex-col min-h-screen pb-20">
    <div class="flex items-center justify-between px-4 pt-3 pb-2">
      <button onclick="showScreen('profile')" class="w-8 h-8 rounded-full bg-white/5 flex items-center justify-center text-white/60">‹</button>
      <div class="flex items-center gap-1.5 text-xs text-emerald-400">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 pulse-dot"></span>
        <span>72 online</span>
      </div>
      <button class="w-8 h-8 rounded-full bg-white/5 flex items-center justify-center text-white/60 text-sm">✕</button>
    </div>

    <div class="flex flex-col items-center pt-8 pb-6 px-4">
      <div class="text-5xl mb-4">💎</div>
      <h2 class="text-xl font-semibold mb-1">Invite friends and earn</h2>
      <p class="text-emerald-400 font-medium text-sm">10% of their fees</p>
    </div>

    <div class="mx-6 mb-6 rounded-2xl bg-card border border-white/10 p-5 text-center">
      <div class="text-xs text-white/40 mb-1">You earned</div>
      <div class="text-3xl font-bold mb-4" id="ref-earned">0 GRAM</div>
      <button onclick="openHowReferrals()" class="px-4 py-2 rounded-xl bg-white/10 text-sm font-medium hover:bg-white/15 transition">How it works</button>
    </div>

    <div class="text-center text-xs text-white/40 mb-4">You invited <span id="ref-count">0</span> friends</div>

    <div class="mx-4 flex gap-3 mt-auto mb-6">
      <button onclick="copyRefLink()" class="flex-1 h-12 rounded-xl bg-white/10 text-sm font-medium hover:bg-white/15 transition">Copy link</button>
      <button onclick="copyRefLink()" class="flex-1 h-12 rounded-xl bg-white text-black text-sm font-semibold hover:bg-gray-100 transition">Invite</button>
    </div>
  </div>

  <!-- BOTTOM NAV -->
  <nav class="fixed bottom-0 left-0 right-0 bg-[#0f0f16]/95 backdrop-blur-md border-t border-white/5 safe-bottom z-40">
    <div class="flex items-center justify-around py-2 max-w-md mx-auto">
      <button onclick="showScreen('pvp')" id="nav-pvp" class="flex flex-col items-center gap-0.5 px-6 py-1 text-cyan-400">
        <span class="text-lg">⚔️</span><span class="text-[10px] font-medium">PvP</span>
      </button>
      <button onclick="showScreen('profile')" id="nav-profile" class="flex flex-col items-center gap-0.5 px-6 py-1 text-white/40">
        <span class="text-lg">👤</span><span class="text-[10px] font-medium">Profile</span>
      </button>
    </div>
  </nav>

  <!-- MODAL: Add Bet -->
  <div id="modal-bet" class="fixed inset-0 z-50 hidden items-end justify-center modal-backdrop" onclick="if(event.target===this)closeModals()">
    <div class="w-full max-w-md bg-card rounded-t-3xl p-5 slide-up border-t border-white/10">
      <div class="flex items-center justify-between mb-4">
        <h3 class="text-lg font-semibold">Add to PvP</h3>
        <button onclick="closeModals()" class="w-8 h-8 rounded-full bg-white/5 flex items-center justify-center text-white/50">✕</button>
      </div>
      <div class="mb-4">
        <label class="text-xs text-white/40 mb-1.5 block">Amount (GRAM)</label>
        <input id="bet-amount" type="number" min="0.1" step="0.1" value="1"
          class="w-full bg-dark border border-white/10 rounded-xl px-4 py-3 text-lg font-semibold outline-none focus:border-cyan-500/50" />
      </div>
      <div class="flex gap-2 mb-4">
        <button onclick="setBetAmount(1)" class="flex-1 py-2 rounded-lg bg-white/5 text-sm">1</button>
        <button onclick="setBetAmount(5)" class="flex-1 py-2 rounded-lg bg-white/5 text-sm">5</button>
        <button onclick="setBetAmount(10)" class="flex-1 py-2 rounded-lg bg-white/5 text-sm">10</button>
        <button onclick="setBetAmount('max')" class="flex-1 py-2 rounded-lg bg-white/5 text-sm">Max</button>
      </div>
      <button onclick="confirmBet()" class="w-full h-12 rounded-xl bg-gradient-to-r from-amber-500 to-yellow-400 text-black font-semibold text-sm">Confirm Bet</button>
    </div>
  </div>

  <!-- MODAL: Deposit -->
  <div id="modal-deposit" class="fixed inset-0 z-50 hidden items-end justify-center modal-backdrop" onclick="if(event.target===this)closeModals()">
    <div class="w-full max-w-md bg-card rounded-t-3xl p-5 slide-up border-t border-white/10">
      <div class="flex items-center justify-between mb-4">
        <h3 class="text-lg font-semibold">Deposit</h3>
        <button onclick="closeModals()" class="w-8 h-8 rounded-full bg-white/5 flex items-center justify-center text-white/50">✕</button>
      </div>
      <p class="text-sm text-white/50 mb-4">Demo: add test GRAM to your balance.</p>
      <div class="flex gap-2 mb-4">
        <button onclick="doDeposit(10)" class="flex-1 py-3 rounded-xl bg-white/5 text-sm font-medium">+10</button>
        <button onclick="doDeposit(50)" class="flex-1 py-3 rounded-xl bg-white/5 text-sm font-medium">+50</button>
        <button onclick="doDeposit(100)" class="flex-1 py-3 rounded-xl bg-white/5 text-sm font-medium">+100</button>
      </div>
    </div>
  </div>

  <!-- MODAL: How Referrals -->
  <div id="modal-how-ref" class="fixed inset-0 z-50 hidden items-center justify-center modal-backdrop p-4" onclick="if(event.target===this)closeModals()">
    <div class="w-full max-w-sm bg-card rounded-2xl p-5 slide-up border border-white/10">
      <div class="flex items-center justify-between mb-4">
        <h3 class="text-lg font-semibold">How Referrals Work</h3>
        <button onclick="closeModals()" class="w-8 h-8 rounded-full bg-white/5 flex items-center justify-center text-white/50">✕</button>
      </div>
      <div class="flex items-center justify-center gap-3 mb-5 py-3 bg-dark rounded-xl">
        <div class="text-center">
          <div class="w-10 h-10 rounded-full bg-purple-500/30 flex items-center justify-center mx-auto mb-1 text-lg">👥</div>
          <div class="text-[10px] text-white/50">Invite friends</div>
        </div>
        <span class="text-white/30">→</span>
        <div class="text-center">
          <div class="w-10 h-10 rounded-full bg-cyan-500/30 flex items-center justify-center mx-auto mb-1 text-lg">💎</div>
          <div class="text-[10px] text-white/50">Earn GRAM</div>
        </div>
      </div>
      <ol class="space-y-3 text-sm text-white/70 mb-5">
        <li><strong class="text-white">1.</strong> Copy or share your personal link</li>
        <li><strong class="text-white">2.</strong> Friends start playing via your link</li>
        <li><strong class="text-white">3.</strong> Earn 10% of their fees — credited to your balance</li>
      </ol>
      <div class="flex gap-2">
        <button onclick="copyRefLink(); closeModals()" class="flex-1 h-11 rounded-xl bg-white/10 text-sm font-medium">Copy link</button>
        <button onclick="copyRefLink(); closeModals()" class="flex-1 h-11 rounded-xl bg-white text-black text-sm font-semibold">Invite</button>
      </div>
    </div>
  </div>

  <div id="toast" class="fixed top-16 left-1/2 -translate-x-1/2 z-[60] hidden px-4 py-2 rounded-full bg-white text-black text-sm font-medium shadow-lg"></div>

  <script>
    const COLORS = ['#a855f7','#22d3ee','#f59e0b','#ef4444','#10b981','#ec4899','#3b82f6','#eab308','#8b5cf6','#14b8a6','#f97316','#06b6d4','#d946ef','#84cc16'];

    let state = {
      balance: 25.00,
      players: [],
      rollId: 624900,
      history: [],
      historyFilter: 'all',
      isSpinning: false,
      refEarned: 0,
      refCount: 0,
      username: 'You',
      online: 72 + Math.floor(Math.random() * 20)
    };

    function seedHistory() {
      const names = ['gxwerr','nikipopus','lqpdwasd','cryptoKing','tonMaster','luckyRoll','gramWhale'];
      const now = Date.now();
      for (let i = 0; i < 18; i++) {
        const chance = +(5 + Math.random() * 90).toFixed(2);
        const bet = +(0.5 + Math.random() * 40).toFixed(2);
        const win = +(bet * (100 / chance) * (0.7 + Math.random() * 0.5)).toFixed(2);
        const mult = +(win / bet).toFixed(2);
        state.history.push({
          id: 624899 - i,
          winner: names[Math.floor(Math.random() * names.length)],
          chance, win, mult, bet,
          time: new Date(now - i * 60000 * (2 + Math.random() * 8)),
          type: 'Classic', isMe: false
        });
      }
    }
    seedHistory();

    function $(id) { return document.getElementById(id); }
    function showToast(msg) {
      const t = $('toast');
      t.textContent = msg;
      t.classList.remove('hidden');
      setTimeout(() => t.classList.add('hidden'), 2200);
    }
    function randomColor() {
      const used = state.players.map(p => p.color);
      const available = COLORS.filter(c => !used.includes(c));
      return available.length ? available[Math.floor(Math.random() * available.length)] : COLORS[Math.floor(Math.random() * COLORS.length)];
    }
    function formatGram(n) {
      return Number(n).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    }
    function randomHash() {
      const c = '0123456789abcdef';
      let h = '';
      for (let i = 0; i < 6; i++) h += c[Math.floor(Math.random() * 16)];
      return h + '...' + c[Math.floor(Math.random()*16)] + c[Math.floor(Math.random()*16)] + c[Math.floor(Math.random()*16)] + c[Math.floor(Math.random()*16)];
    }

    function showScreen(name) {
      ['pvp','history','profile','referrals'].forEach(s => {
        const el = $('screen-' + s);
        if (!el) return;
        el.classList.add('hidden');
        el.classList.remove('flex');
      });
      const target = $('screen-' + name);
      if (target) {
        target.classList.remove('hidden');
        target.classList.add('flex');
      }
      $('nav-pvp').className = 'flex flex-col items-center gap-0.5 px-6 py-1 ' + (name === 'pvp' || name === 'history' ? 'text-cyan-400' : 'text-white/40');
      $('nav-profile').className = 'flex flex-col items-center gap-0.5 px-6 py-1 ' + (name === 'profile' || name === 'referrals' ? 'text-cyan-400' : 'text-white/40');
      if (name === 'history') renderHistory();
      if (name === 'profile') updateProfile();
      if (name === 'referrals') {
        $('ref-earned').textContent = formatGram(state.refEarned) + ' GRAM';
        $('ref-count').textContent = state.refCount;
      }
    }

    function updateWheel() {
      const wheel = $('wheel');
      const total = state.players.reduce((s, p) => s + p.amount, 0);
      $('total-bank').textContent = formatGram(total) + ' GRAM';
      $('player-count').textContent = state.players.length;
      $('roll-id').textContent = state.rollId;
      $('round-hash').textContent = randomHash();

      if (state.players.length === 0) {
        wheel.classList.add('empty');
        wheel.style.background = '';
        $('wheel-status').textContent = 'Waiting';
        renderPlayers();
        return;
      }

      wheel.classList.remove('empty');
      let gradient = [], acc = 0;
      state.players.forEach(p => {
        const pct = (p.amount / total) * 100;
        p.chance = +pct.toFixed(2);
        gradient.push(p.color + ' ' + acc + '% ' + (acc + pct) + '%');
        acc += pct;
      });
      wheel.style.background = 'conic-gradient(' + gradient.join(', ') + ')';
      $('wheel-status').textContent = state.isSpinning ? 'Spinning...' : 'Ready';
      renderPlayers();
    }

    function renderPlayers() {
      const list = $('players-list');
      if (state.players.length === 0) {
        list.innerHTML = '<div class="text-center text-white/30 text-sm py-6">No players yet. Be the first!</div>';
        return;
      }
      const total = state.players.reduce((s, p) => s + p.amount, 0);
      list.innerHTML = state.players.map(p => {
        const chance = ((p.amount / total) * 100).toFixed(2);
        return '<div class="flex items-center justify-between rounded-xl bg-card border border-white/5 px-3 py-3 fade-in">' +
          '<div class="flex items-center gap-3">' +
            '<div class="w-9 h-9 rounded-full flex items-center justify-center text-sm border-2" style="border-color:' + p.color + ';background:' + p.color + '22">' + (p.isMe ? '👤' : '🎮') + '</div>' +
            '<div><div class="text-sm font-medium">' + (p.isMe ? '@You' : '@' + p.name) + '</div>' +
            '<div class="text-xs text-white/40">' + chance + '%</div></div></div>' +
          '<div class="px-2.5 py-1 rounded-lg text-sm font-medium" style="background:' + p.color + '18;color:' + p.color + ';border:1px solid ' + p.color + '33">💎 ' + formatGram(p.amount) + '</div></div>';
      }).join('');
    }

    function openAddBet() {
      if (state.isSpinning) return showToast('Round in progress');
      $('bet-amount').value = Math.min(1, state.balance).toFixed(1);
      $('modal-bet').classList.remove('hidden');
      $('modal-bet').classList.add('flex');
    }
    function setBetAmount(v) {
      if (v === 'max') $('bet-amount').value = state.balance.toFixed(2);
      else $('bet-amount').value = v;
    }
    function confirmBet() {
      const amount = parseFloat($('bet-amount').value);
      if (isNaN(amount) || amount < 0.1) return showToast('Min bet 0.1 GRAM');
      if (amount > state.balance) return showToast('Not enough balance');

      state.balance = +(state.balance - amount).toFixed(2);
      updateBalanceUI();

      let me = state.players.find(p => p.isMe);
      if (me) me.amount = +(me.amount + amount).toFixed(2);
      else {
        state.players.push({ id: Date.now(), name: state.username, amount, color: randomColor(), isMe: true });
      }

      if (state.players.length < 5 && Math.random() > 0.35) {
        setTimeout(() => addBot(), 700 + Math.random() * 1800);
      }

      closeModals();
      updateWheel();
      showToast('Bet placed!');

      if (state.players.length >= 2 && !state.isSpinning) {
        setTimeout(() => maybeStartRound(), 2200);
      }
    }

    function addBot() {
      if (state.isSpinning || state.players.length >= 8) return;
      const names = ['CryptoFox','TonNinja','LuckyStar','GramBoss','RollKing','MoonBag','DiamondHands'];
      const name = names[Math.floor(Math.random() * names.length)] + Math.floor(Math.random() * 90);
      const amount = +(0.5 + Math.random() * 15).toFixed(2);
      state.players.push({ id: Date.now() + Math.random(), name, amount, color: randomColor(), isMe: false });
      updateWheel();
      if (state.players.length >= 2 && !state.isSpinning) setTimeout(() => maybeStartRound(), 1800);
    }

    function maybeStartRound() {
      if (state.players.length < 2 || state.isSpinning) return;
      if (Math.random() > 0.3) startSpin();
    }

    function startSpin() {
      if (state.isSpinning || state.players.length < 2) return;
      state.isSpinning = true;
      $('wheel-status').textContent = 'Spinning...';

      const total = state.players.reduce((s, p) => s + p.amount, 0);
      let r = Math.random() * total;
      let winner = state.players[0];
      for (const p of state.players) {
        r -= p.amount;
        if (r <= 0) { winner = p; break; }
      }

      let acc = 0, winnerStart = 0, winnerSize = 0;
      for (const p of state.players) {
        const size = (p.amount / total) * 360;
        if (p === winner) { winnerStart = acc; winnerSize = size; break; }
        acc += size;
      }
      const mid = winnerStart + winnerSize / 2;
      const extraSpins = 4 + Math.floor(Math.random() * 3);
      const finalDeg = extraSpins * 360 + (360 - mid);

      const wheel = $('wheel');
      wheel.style.transition = 'none';
      wheel.style.transform = 'rotate(0deg)';
      void wheel.offsetWidth;
      wheel.style.transition = 'transform 4.2s cubic-bezier(0.12, 0.8, 0.2, 1)';
      wheel.style.transform = 'rotate(' + finalDeg + 'deg)';

      setTimeout(() => finishRound(winner, total), 4400);
    }

    function finishRound(winner, total) {
      state.isSpinning = false;
      const mult = +(total / winner.amount).toFixed(2);
      const winAmount = +total.toFixed(2);

      if (winner.isMe) {
        state.balance = +(state.balance + winAmount).toFixed(2);
        updateBalanceUI();
        showToast('You won ' + formatGram(winAmount) + ' GRAM! x' + mult);
      } else {
        showToast('@' + winner.name + ' won ' + formatGram(winAmount) + ' GRAM');
      }

      state.history.unshift({
        id: state.rollId,
        winner: winner.isMe ? 'You' : winner.name,
        chance: +((winner.amount / total) * 100).toFixed(2),
        win: winAmount, mult, bet: winner.amount,
        time: new Date(), type: 'Classic', isMe: winner.isMe
      });

      state.players = [];
      state.rollId++;
      const wheel = $('wheel');
      wheel.style.transition = 'none';
      wheel.style.transform = 'rotate(0deg)';
      updateWheel();
    }

    function setHistoryFilter(f) {
      state.historyFilter = f;
      document.querySelectorAll('.filter-btn').forEach(btn => {
        const active = btn.dataset.filter === f;
        btn.classList.toggle('active', active);
        btn.classList.toggle('text-white/50', !active);
      });
      renderHistory();
    }

    function renderHistory() {
      const search = ($('history-search') && $('history-search').value || '').trim().toLowerCase();
      let list = state.history.slice();
      if (state.historyFilter === 'lucky') list.sort((a, b) => a.chance - b.chance);
      else if (state.historyFilter === 'top') list.sort((a, b) => b.win - a.win);
      if (search) list = list.filter(h => String(h.id).includes(search));

      const container = $('history-list');
      if (!list.length) {
        container.innerHTML = '<div class="text-center text-white/30 py-10 text-sm">No games found</div>';
        return;
      }

      container.innerHTML = list.map(h => {
        const timeStr = h.time.toLocaleString('en-GB', { day: '2-digit', month: '2-digit', hour: '2-digit', minute: '2-digit' });
        return '<div class="rounded-xl bg-card border border-white/5 px-3.5 py-3">' +
          '<div class="flex items-center justify-between mb-2">' +
            '<div class="flex items-center gap-1.5"><span class="text-[10px] text-white/40">✕</span><span class="text-xs text-white/50">' + h.type + '</span></div>' +
            '<span class="text-[10px] text-white/30">#' + h.id + ' · ' + timeStr + '</span></div>' +
          '<div class="flex items-center justify-between">' +
            '<div class="flex items-center gap-2.5">' +
              '<div class="w-8 h-8 rounded-full bg-white/5 flex items-center justify-center text-sm">' + (h.isMe ? '👤' : '🎮') + '</div>' +
              '<div><div class="text-sm font-medium">@' + h.winner + '</div><div class="text-[11px] text-white/40">' + h.chance + '%</div></div></div>' +
            '<div class="text-right"><div class="text-sm font-semibold text-cyan-300">+' + formatGram(h.win) + ' GRAM</div><div class="text-[11px] text-white/40">x' + h.mult + '</div></div></div>' +
          '<div class="mt-2"><span class="px-2 py-0.5 rounded-md bg-cyan-500/15 text-cyan-300 text-[11px] font-medium">💎 ' + formatGram(h.bet) + '</span></div></div>';
      }).join('');
    }

    function updateBalanceUI() {
      $('user-balance').textContent = formatGram(state.balance);
      $('bet-btn-balance').textContent = formatGram(state.balance) + ' Gram';
      if ($('profile-balance')) $('profile-balance').textContent = formatGram(state.balance) + ' GRAM';
    }
    function updateProfile() {
      $('profile-balance').textContent = formatGram(state.balance) + ' GRAM';
      $('profile-username').textContent = '@' + state.username;
    }
    function openDeposit() {
      $('modal-deposit').classList.remove('hidden');
      $('modal-deposit').classList.add('flex');
    }
    function doDeposit(amount) {
      state.balance = +(state.balance + amount).toFixed(2);
      updateBalanceUI();
      closeModals();
      showToast('+' + amount + ' GRAM deposited');
    }

    function openHowReferrals() {
      $('modal-how-ref').classList.remove('hidden');
      $('modal-how-ref').classList.add('flex');
    }
    function copyRefLink() {
      const link = 'https://t.me/gramelle_bot?start=ref_' + state.username.toLowerCase();
      if (navigator.clipboard) navigator.clipboard.writeText(link).then(() => showToast('Link copied!')).catch(() => showToast(link));
      else showToast(link);
    }

    function closeModals() {
      ['modal-bet','modal-deposit','modal-how-ref'].forEach(id => {
        const el = $(id);
        el.classList.add('hidden');
        el.classList.remove('flex');
      });
    }

    function init() {
      updateWheel();
      updateBalanceUI();
      $('online-count').textContent = state.online + ' online';
      $('online-count-2').textContent = state.online + ' online';
      setInterval(() => {
        state.online = 60 + Math.floor(Math.random() * 40);
        document.querySelectorAll('#online-count, #online-count-2').forEach(e => e.textContent = state.online + ' online');
      }, 8000);
    }
    init();
  </script>
</body>
</html>
